@model IEnumerable<LuyenTapTX2_3.Models.Category>
@{
    ViewBag.Title = "Category";
}

<h2>Hãng</h2>

<p>
    @Html.ActionLink("Thêm mới sản phẩm", "Create") 
</p>

<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.CategoryName) 
        </th>
        <th>
            Số lượng
        </th>
    </tr>

    @foreach( var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayNameFor(item=> item.CategoryName)
                    </td>
                    <td>
                        @item.MetaTitle.Count()  
                    </td>
                </tr>
            }
</table>

